<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS obligatoire : aucune connexion non chiffrée possible. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
