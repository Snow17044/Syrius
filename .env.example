# Copie ce fichier en ".env" puis remplis-le. Ne le partage JAMAIS (il contient tes clés).

# --- Obligatoire ---
# Ton adresse gratuite (ex. monsyrius.duckdns.org) - utilisée pour le HTTPS
SYRIUS_DOMAIN=

# --- Cerveau (IA locale, gratuite) ---
# Choisis selon la mémoire (RAM) de ton serveur :
#   24 Go et plus (ex. Oracle Cloud gratuit) : qwen3:30b   (recommandé : rapide et intelligent)
#   16 Go                                   : qwen3:14b
#   8 Go                                    : qwen3:8b
SYRIUS_MODEL=qwen3:30b
# SYRIUS_CONTEXT=16384
# SYRIUS_SESSION_DAYS=30

# --- Recherche web (optionnelle, gratuite) ---
# Crée un compte gratuit sur ollama.com puis une clé : https://ollama.com/settings/keys
# (Les recherches sont envoyées à ollama.com ; tes discussions, elles, restent chez toi.)
# OLLAMA_API_KEY=

# --- Emails (optionnel) ---
# Gmail : active la validation en 2 étapes puis crée un "mot de passe d'application"
# SYRIUS_EMAIL_AUTH=password
# SYRIUS_IMAP_HOST=imap.gmail.com
# SYRIUS_SMTP_HOST=smtp.gmail.com
# SYRIUS_SMTP_PORT=587
# SYRIUS_EMAIL_USER=ton.adresse@gmail.com
# SYRIUS_EMAIL_PASSWORD=mot-de-passe-d-application

# Outlook / Hotmail / Live : connexion Microsoft sécurisée (OAuth2), voir README
# SYRIUS_EMAIL_AUTH=outlook
# SYRIUS_IMAP_HOST=outlook.office365.com
# SYRIUS_SMTP_HOST=smtp-mail.outlook.com
# SYRIUS_SMTP_PORT=587
# SYRIUS_EMAIL_USER=ton.adresse@hotmail.fr
# SYRIUS_MS_CLIENT_ID=
