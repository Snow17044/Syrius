# Variables de Syrius.
# - Sur Vercel : ajoute-les dans Settings -> Environment Variables (voir README).
# - Chez toi (docker compose) : copie ce fichier en ".env" et remplis-le. Ne le partage JAMAIS.

# --- Cerveaux (au moins un) ---
GROQ_API_KEY=
GEMINI_API_KEY=
# SYRIUS_GROQ_MODEL=openai/gpt-oss-120b
# SYRIUS_GEMINI_MODEL=gemini-flash-latest

# --- Premier lancement : code secret pour créer ton mot de passe dans l'app ---
SYRIUS_SETUP_CODE=

# --- Base de données Upstash (Vercel les ajoute tout seul via Storage) ---
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Recherche web (optionnelle, clé gratuite sur ollama.com) ---
# OLLAMA_API_KEY=

# --- Emails (optionnel) : voir README ---
# SYRIUS_EMAIL_AUTH=password
# SYRIUS_IMAP_HOST=imap.gmail.com
# SYRIUS_SMTP_HOST=smtp.gmail.com
# SYRIUS_SMTP_PORT=587
# SYRIUS_EMAIL_USER=
# SYRIUS_EMAIL_PASSWORD=
# SYRIUS_MS_CLIENT_ID=

# --- Uniquement pour l'hébergement chez toi avec docker compose ---
# Adresse pour le HTTPS (ex. monsyrius.duckdns.org)
# SYRIUS_DOMAIN=
# IA locale (Ollama) : 12 Go de RAM -> qwen3:8b ; 24 Go -> qwen3:30b
# SYRIUS_OLLAMA_MODEL=qwen3:8b
